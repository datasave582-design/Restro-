rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function admin(){ return signedIn() && root.child('admins').child(request.auth.uid).val() == true; }
    function captain(){ return signedIn() && root.child('staff').child(request.auth.uid).child('role').val() == 'captain' && root.child('staff').child(request.auth.uid).child('active').val() == true; }
    match /admins/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow write: if admin(); }
    match /staff/{uid} { allow read: if admin() || (signedIn() && request.auth.uid == uid); allow write: if admin(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    match /tables/{id} { allow read: if admin() || captain(); allow create, delete: if admin(); allow update: if admin() || captain(); }
    match /products/{id} { allow read: if true; allow create, update, delete: if admin(); }
    match /reservations/{id} {
      allow create: if request.resource.data.status == 'pending' && request.resource.data.name is string && request.resource.data.phone is string && request.resource.data.date is string && request.resource.data.time is string && request.resource.data.guests is number;
      allow read: if admin() || captain();
      allow update, delete: if admin() || captain();
    }
  }
}
